# Copie para relay.env (modo 600, FORA do git) e preencha. Nenhum valor real vai para o repositorio.
RELAY_DB=/data/relay.db
RELAY_DAILY_QUOTA=200
RELAY_SYNC_TIMEOUT=4

# Skill compartilhada (so depois de criada no console da Amazon)
ALEXA_SKILL_ID=amzn1.ask.skill.fc482e95-ab16-4ba8-8539-c1ff52c48222
OAUTH_CLIENT_ID=heycode-alexa
# gere com: openssl rand -hex 32
OAUTH_CLIENT_SECRET=
# "Redirect URLs" que o console da Amazon mostra na tela de account linking, separadas por virgula
OAUTH_REDIRECT_URIS=
