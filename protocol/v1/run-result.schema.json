{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heycode:protocol/v1/run-result",
  "type": "object",
  "required": [
    "run_id",
    "state",
    "summary"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "done",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "summary": {
      "type": "string"
    }
  }
}
