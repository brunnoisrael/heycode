{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heycode:protocol/v1/decision-request",
  "type": "object",
  "required": [
    "confirmation_id",
    "operation",
    "destination",
    "summary"
  ],
  "properties": {
    "confirmation_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    }
  }
}
